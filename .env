# ---- Deploy (EasyPanel / Docker) ----
# Variáveis de BUILD do Docusaurus (lidas em docusaurus.config.ts com fallback).
# Sobrescreva com a URL pública real do site de docs no EasyPanel.
# DOCS_URL: origem pública (sem barra final). Usada em sitemap/canonical.
DOCS_URL=https://loja-fiap.exemplo
# DOCS_BASE_URL: caminho base (mantenha "/" se o site fica na raiz do domínio).
DOCS_BASE_URL=/
